{
  "name": "vuzopedia-orginal",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-10",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
